# Copy to /opt/sglang/sglang.env. Do not commit the live file.

SGLANG_ROOT=/opt/sglang
SGLANG_CACHE=/opt/sglang/cache

# Pin the image. Change it on the weight step if a newer SGLang build is required.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.19
SGLANG_PORT=30000

# The name DSH selects. The checkpoint itself is chosen later.
SGLANG_SERVED_MODEL_NAME=qwen3.8-27b-local

# Leave these empty until the weight step. An empty path makes start-server.sh
# exit before loading a model.
SGLANG_MODEL_PATH=
SGLANG_CONTEXT_LENGTH=
SGLANG_EXTRA_ARGS=

# Optional shared bearer token. When set, it must match SGLANG_API_KEY in
# /opt/dsh/dsh.env. Empty means the loopback server does not require a key.
SGLANG_API_KEY=
