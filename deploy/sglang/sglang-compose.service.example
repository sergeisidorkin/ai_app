# Copy to /etc/systemd/system/sglang-compose.service.
# Do not enable this unit until SGLANG_MODEL_PATH is set. Enabling it starts
# the container and pulls the image.

[Unit]
Description=SGLang Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sglang
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/bin/sh -c '/usr/bin/docker network inspect dsh-sglang >/dev/null 2>&1 || { echo "dsh-sglang network is missing; start the DSH stack first" >&2; exit 1; }'
ExecStart=/usr/bin/docker compose --env-file /opt/sglang/sglang.env up -d
ExecStartPost=/opt/sglang/sglang-healthcheck.sh
ExecStop=/usr/bin/docker compose --env-file /opt/sglang/sglang.env stop
ExecReload=/usr/bin/docker compose --env-file /opt/sglang/sglang.env up -d
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
