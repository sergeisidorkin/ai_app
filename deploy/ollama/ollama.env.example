# Copy to ollama.env next to docker-compose.yml.

ROOT=/opt/ollama

# Pin the official image tag. Bump deliberately; do not use latest.
OLLAMA_IMAGE=ollama/ollama:0.34.0

OLLAMA_LOCAL_PORT=11434
OLLAMA_KEEP_ALIVE=10m

# Model pulled by pull-model.sh after the stack is up.
OLLAMA_MODEL=qwen3.5:9b

AI_DOCKER_NETWORK=imc-ai
