# Copy to dsh.env next to docker-compose.yml. All persistent data lives under ROOT.

ROOT=/opt/dsh

# Official npm package pin. Rebuild the image after changing this.
DSH_VERSION=0.1.5-rc.1
DSH_IMAGE=imc-dsh

DSH_HOST=dsh.imcmontanai.ru
DSH_LOCAL_PORT=3080
DSH_PUBLIC_URL=https://dsh.imcmontanai.ru

# 1000 matches the `node` user in the image. Use the host account that owns ROOT.
DSH_UID=1000
DSH_GID=1000

# Provider keys can be stored by the DSH Web UI. Environment variables remain
# available for unattended bootstrap and key rotation.
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# Official DeepSeek card in the Web UI, if you still want that route.
# DEEPSEEK_API_KEY=

# Leave the local LLM URL empty when using a hosted provider.
DSH_LLM_BASE_URL=
DSH_LLM_MODEL=

# Later, same-host Ollama (deploy/ollama + docker-compose.ollama.yml):
# DSH_LLM_BASE_URL=http://ollama:11434/v1
# DSH_LLM_MODEL=qwen3.5:9b
# OLLAMA_API_KEY=ollama

# Public nginx hostname (and optional :port). Comma-separated.
# Required for HTTPS access through the host reverse proxy.
DSH_TRUSTED_HOSTS=dsh.imcmontanai.ru
