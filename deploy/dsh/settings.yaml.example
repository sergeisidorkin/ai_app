# Seeded into $DSH_HOME/settings.yaml on first start when SILICONFLOW_API_KEY is set.
# After that, edit the live file or the Web UI (Settings → Models).
# The API key is not stored here: set SILICONFLOW_API_KEY in dsh.env or paste it in the UI.

llm-pi-ai:
  providers:
    siliconflow:
      displayName: SiliconFlow
      apiKeyEnv: SILICONFLOW_API_KEY
      api: openai-completions
      baseURL: https://api.siliconflow.com/v1
      compat:
        supportsDeveloperRole: false
        maxTokensField: max_tokens
      models:
        - id: Qwen/Qwen3.5-27B
          name: Qwen3.5-27B (SiliconFlow)
          input: [text, image]
          contextWindow: 262144
          maxTokens: 8192

agent-default-model:
  provider: siliconflow
  model: Qwen/Qwen3.5-27B
