# Django-side DSH settings. Copy the needed lines into the gunicorn env
# (do not merge this file into dsh.env — that file is for the container).
#
# DSH is a separate Compose stack. Gunicorn does not install Node or npx.
# Headless sort runs `docker compose exec` into the already running container.
# The run directory must live on the same bind-mount as DSH_HOME's sibling
# workspace volume: host /opt/dsh/workspace <-> container /workspace.

DSH_BASE_URL=https://dsh.imcmontanai.ru
DSH_COMPOSE_DIR=/opt/dsh
DSH_SORT_WORKSPACE=/opt/dsh/workspace/sort-runs
DSH_HEADLESS_CONTAINER_CWD=/workspace/sort-runs
# Quoted because deploy.yml sources prod.env with bash; systemd EnvironmentFile
# accepts the same quoting.
DSH_HEADLESS_CMD='docker compose --project-directory /opt/dsh --env-file /opt/dsh/dsh.env exec -T -w {cwd} dsh dsh --profile headless'
DSH_HEADLESS_TIMEOUT=900
DSH_SORT_ALLOW_LOCAL_INBOX=0

# Leave empty on prod. Do not point Django at a host nvm or npm cache.
# DSH_HOME=
# DSH_NODE_BIN=
# DSH_NPM_CACHE=
